rules_version = '2';

// Codeman's operational store. Only Codeman's jobs reach it, as a service account that IAM
// authorizes, to which these rules do not apply. They deny every client: no Firebase app, web
// page or anonymous request may read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
